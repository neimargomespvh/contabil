# ============================================
# BANCO DE DADOS
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contabil?schema=public"

# ============================================
# APLICAÇÃO
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# JWT
# ============================================
JWT_SECRET="troque-por-uma-chave-de-64-caracteres"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="outra-chave-de-64-caracteres"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================
# AWS / S3
# ============================================
AWS_REGION="sa-east-1"
AWS_S3_BUCKET="contabil-docs"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ============================================
# REDIS
# ============================================
REDIS_URL="redis://localhost:6379"