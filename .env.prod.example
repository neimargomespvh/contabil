# ═══════════════════════════════════════════════════════
# PRODUÇÃO — copie para .env.prod e preencha
# ═══════════════════════════════════════════════════════

# ─── POSTGRES ───
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-senha-forte
POSTGRES_DB=contabil

# ─── REDIS ───
REDIS_PASSWORD=troque-por-senha-redis-forte

# ─── JWT (mínimo 64 chars cada) ───
JWT_SECRET=troque-por-chave-64-chars-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=troque-por-chave-64-chars-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── PORTS ───
API_PORT=3000
WEB_PORT=8080

# ─── FRONTEND URL ───
VITE_API_URL=http://localhost:3000/api/v1

# ─── AWS S3 (opcional) ───
AWS_REGION=sa-east-1
AWS_S3_BUCKET=contabil-docs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
